# Copy this file to .env (same folder) and fill in the values. .env is git-ignored;
# never commit real keys. Values are read by python-dotenv (no quotes needed).

# ACLED API login (acleddata.com account) - conflict events for the risk index and the website overlay
ACLED_EMAIL=
ACLED_PASSWORD=

# DeepSeek API key - writes the website's AI briefs (English + Chinese) at each data refresh.
# Create one at https://platform.deepseek.com/api_keys (pay-as-you-go; top up a small balance first).
DEEPSEEK_API_KEY=

# News APIs - recent China-related coverage cited in the website's China briefs (also used in the text-feature experiments)
GUARDIAN_API_KEY=
NYT_API_KEY=

# UN Comtrade key - only for src/fetch_comtrade_energy.py (Hormuz energy detail)
COMTRADE_KEY=
